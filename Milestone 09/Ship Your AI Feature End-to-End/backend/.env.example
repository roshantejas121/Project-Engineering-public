# Server-side only. Never place this key in frontend files.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional local compatibility override. Leave unset in the Render deployment.
# AI_API_BASE_URL=https://your-openai-compatible-provider.example/v1
# AI_API_KEY=your-server-side-key
# AI_MODEL=gpt-5-mini

# Comma-separated frontend origins. Use * only for local smoke tests.
FRONTEND_URLS=http://localhost:5173

PORT=3000
NODE_ENV=development
